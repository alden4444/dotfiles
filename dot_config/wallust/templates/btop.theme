# Generated by wallust, do not edit.

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#{{ background | strip }}"

# Main text color
theme[main_fg]="#{{ foreground | strip }}"

# Title color for boxes
theme[title]="#{{ color14 | strip }}"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#{{ color12 | strip }}"

# Background color of selected item in processes box
theme[selected_bg]="#{{ color8 | strip }}"

# Foreground color of selected item in processes box
theme[selected_fg]="#{{ color15 | strip }}"

# Color of inactive/disabled text
theme[inactive_fg]="#{{ color8 | strip }}"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#{{ color13 | strip }}"

# Cpu box outline color
theme[cpu_box]="#{{ color8 | strip }}"

# Memory/disks box outline color
theme[mem_box]="#{{ color8 | strip }}"

# Net up/down box outline color
theme[net_box]="#{{ color8 | strip }}"

# Processes box outline color
theme[proc_box]="#{{ color8 | strip }}"

# Box divider line and small boxes line color
theme[div_line]="#{{ color8 | strip }}"

# Temperature graph colors
theme[temp_start]="#{{ color4 | strip }}"
theme[temp_mid]="#{{ color6 | strip }}"
theme[temp_end]="#{{ color1 | strip }}"

# CPU graph colors
theme[cpu_start]="#{{ color4 | strip }}"
theme[cpu_mid]="#{{ color6 | strip }}"
theme[cpu_end]="#{{ color5 | strip }}"

# Mem/Disk free meter
theme[free_start]="#{{ color2 | strip }}"
theme[free_mid]="#{{ color6 | strip }}"
theme[free_end]="#{{ color4 | strip }}"

# Mem/Disk cached meter
theme[cached_start]="#{{ color4 | strip }}"
theme[cached_mid]="#{{ color6 | strip }}"
theme[cached_end]="#{{ color13 | strip }}"

# Mem/Disk available meter
theme[available_start]="#{{ color3 | strip }}"
theme[available_mid]="#{{ color4 | strip }}"
theme[available_end]="#{{ color6 | strip }}"

# Mem/Disk used meter
theme[used_start]="#{{ color2 | strip }}"
theme[used_mid]="#{{ color3 | strip }}"
theme[used_end]="#{{ color1 | strip }}"

# Download graph colors
theme[download_start]="#{{ color2 | strip }}"
theme[download_mid]="#{{ color6 | strip }}"
theme[download_end]="#{{ color4 | strip }}"

# Upload graph colors
theme[upload_start]="#{{ color4 | strip }}"
theme[upload_mid]="#{{ color5 | strip }}"
theme[upload_end]="#{{ color1 | strip }}"
