{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "$(hyde-shell fastfetch logo)",
    "height": 18
  },
  "display": {
    "separator": " : "
  },
  "modules": [
    {
      "type": "custom",
      "format": "┌──────────────────────────────────────────┐"
    },
    "chassis",
    {
      "type": "os",
      "key": "OS",
      "format": "{2}",
      "keyColor": "bright_red"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "format": "{2}",
      "keyColor": "bright_red"
    },
    {
      "type": "packages",
      "key": "Packages",
      "keyColor": "bright_red"
    },
    {
      "type": "display",
      "key": "Display",
      "format": "{1}x{2} @ {3}Hz [{7}]",
      "keyColor": "bright_red"
    },
    {
      "type": "terminal",
      "key": "Terminal",
      "keyColor": "bright_red"
    },
    {
      "type": "wm",
      "key": "WM",
      "format": "{2}",
      "keyColor": "bright_red"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "title",
      "key": " ",
      "format": "{6} {7} {8}"
    },
    {
      "type": "custom",
      "format": "┌──────────────────────────────────────────┐"
    },
    {
      "type": "cpu",
      "format": "{1} ({7})",
      "key": "CPU",
      "keyColor": "bright_red"
    },
    {
      "type": "gpu",
      "driverSpecific": true,
      "temp": false,
      "keyColor": "bright_red"
    },
    {
      "type": "gpu",
      "key": "GPU Driver",
      "keyColor": "bright_red"
    },
    {
      "type": "memory",
      "key": "Memory ",
      "keyColor": "bright_red"
    },
    {
      "type": "disk",
      "key": "OS Age ",
      "folders": "/",
      "keyColor": "bright_red",
      "format": "{days} days"
    },
    {
      "type": "uptime",
      "key": "Uptime ",
      "keyColor": "bright_red"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────┘"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    },
    "break"
  ]
}
