#!/usr/bin/env bash
set -e

CANVAS_DIR="${CANVAS_TUI_DIR:-$HOME/canvas-lms-tui}"
UV_BIN="$(command -v uv 2>/dev/null || echo "$HOME/.local/bin/uv")"

if [ ! -d "$CANVAS_DIR" ]; then
    echo "Error: Canvas TUI directory not found at $CANVAS_DIR" >&2
    exit 1
fi

if [ ! -x "$UV_BIN" ]; then
    echo "Error: uv executable not found" >&2
    exit 1
fi

exec "$UV_BIN" run --directory "$CANVAS_DIR" python src/main.py "$@"
