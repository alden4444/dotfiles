#!/usr/bin/env python3
"""
rgb-theme: Minimal, neat PC RGB theme manager.
"""

import sys
import os
import json
import socket
import struct
import shutil
import termios
import tty
import time
import datetime

OPENRGB_HOST = "127.0.0.1"
OPENRGB_PORT = 6742
CONFIG_DIR = os.path.expanduser("~/.config/OpenRGB")
PROFILES_DIR = os.path.join(CONFIG_DIR, "profiles")
CATALOG_FILE = os.path.join(CONFIG_DIR, "themes.json")
STATE_DIR = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
CURRENT_THEME_FILE = os.path.join(STATE_DIR, "rgb-current-theme")
DEFAULT_THEME_FILE = os.path.join(CONFIG_DIR, "default-theme-id")
INHIBIT_FILE = os.path.join(STATE_DIR, "rgb-inhibit-until")
BRIGHTNESS_FILE = os.path.join(STATE_DIR, "rgb-brightness")
FADE_BRIGHTNESS_FILE = os.path.join(STATE_DIR, "rgb-fade-brightness")


# ==============================================================
# Brightness State
# ==============================================================

def get_brightness():
    if os.path.exists(BRIGHTNESS_FILE):
        try:
            with open(BRIGHTNESS_FILE, "r") as f:
                return max(1, min(100, int(float(f.read().strip()))))
        except Exception:
            pass
    return 100


def set_brightness(percent):
    percent = max(1, min(100, int(percent)))
    try:
        with open(BRIGHTNESS_FILE, "w") as f:
            f.write(f"{percent}\n")
        with open(FADE_BRIGHTNESS_FILE, "w") as f:
            f.write(f"{percent / 100.0:.4f}\n")
    except Exception:
        pass
    curr = get_current_theme()
    get_client().apply_theme(curr, percent)
    return percent


# ==============================================================
# Fast OpenRGB Socket Client (0.03ms instant updates)
# ==============================================================

class FastRGBClient:
    def __init__(self, host=OPENRGB_HOST, port=OPENRGB_PORT):
        self.host = host
        self.port = port
        self.sock = None
        self.profile_cache = {}
        self.connect()

    def connect(self):
        try:
            self.sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            self.sock.settimeout(0.5)
            self.sock.connect((self.host, self.port))
            self.sock.sendall(struct.pack('<4sIII', b'ORGB', 0, 40, 4) + struct.pack('<I', 4))
            self.sock.recv(20)
            name = b'RGBTheme\x00'
            self.sock.sendall(struct.pack('<4sIII', b'ORGB', 0, 50, len(name)) + name)
            return True
        except Exception:
            self.sock = None
            return False

    def load_profile_colors(self, theme_id):
        if theme_id in self.profile_cache:
            return self.profile_cache[theme_id]
        p_path = os.path.join(PROFILES_DIR, f"{theme_id}.json")
        if not os.path.exists(p_path):
            return None
        try:
            with open(p_path, 'r') as f:
                data = json.load(f)
            def int_to_rgb(val):
                return (val & 0xFF, (val >> 8) & 0xFF, (val >> 16) & 0xFF)
            ram = [int_to_rgb(c) for c in data['controllers'][0]['colors']]
            mobo = [int_to_rgb(c) for c in data['controllers'][2]['colors']]
            self.profile_cache[theme_id] = (ram, mobo)
            return ram, mobo
        except Exception:
            return None

    def send_update_leds(self, dev_id, colors_rgb):
        color_bytes = b''.join(struct.pack('BBBx', r, g, b) for r, g, b in colors_rgb)
        inner = struct.pack('<H', len(colors_rgb)) + color_bytes
        buff = struct.pack('<I', len(inner) + 4) + inner
        hdr = struct.pack('<4sIII', b'ORGB', dev_id, 1050, len(buff))
        self.sock.sendall(hdr + buff)

    def apply_theme(self, theme_id, brightness=None):
        colors = self.load_profile_colors(theme_id)
        if not colors:
            return False
        ram, mobo = colors

        if brightness is None:
            brightness = get_brightness()
        factor = max(0.01, min(1.0, brightness / 100.0))

        scaled_ram = [(int(r * factor), int(g * factor), int(b * factor)) for r, g, b in ram]
        scaled_mobo = [(int(r * factor), int(g * factor), int(b * factor)) for r, g, b in mobo]

        if not self.sock:
            if not self.connect():
                return False
        try:
            self.send_update_leds(0, scaled_ram)
            self.send_update_leds(1, scaled_ram)
            self.send_update_leds(2, scaled_mobo)
            try:
                with open(CURRENT_THEME_FILE, "w") as f:
                    f.write(theme_id)
            except Exception:
                pass
            return True
        except Exception:
            if self.connect():
                try:
                    self.send_update_leds(0, scaled_ram)
                    self.send_update_leds(1, scaled_ram)
                    self.send_update_leds(2, scaled_mobo)
                    try:
                        with open(CURRENT_THEME_FILE, "w") as f:
                            f.write(theme_id)
                    except Exception:
                        pass
                    return True
                except Exception:
                    pass
        return False

    def close(self):
        if self.sock:
            try:
                self.sock.close()
            except Exception:
                pass
            self.sock = None


_client = None

def get_client():
    global _client
    if _client is None:
        _client = FastRGBClient()
    return _client


def load_catalog():
    if os.path.exists(CATALOG_FILE):
        try:
            with open(CATALOG_FILE, "r") as f:
                return json.load(f)
        except Exception:
            pass
    return []


def hex_to_rgb_tuple(h):
    h = h.lstrip('#')
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)


def fg_color(r, g, b):
    return f"\033[38;2;{r};{g};{b}m"


RESET = "\033[0m"
BOLD = "\033[1m"
DIM = "\033[2m"


def get_current_theme():
    if os.path.exists(CURRENT_THEME_FILE):
        try:
            with open(CURRENT_THEME_FILE, "r") as f:
                return f.read().strip()
        except Exception:
            pass
    return "amethyst-frost"


def get_default_theme():
    if os.path.exists(DEFAULT_THEME_FILE):
        try:
            with open(DEFAULT_THEME_FILE, "r") as f:
                return f.read().strip()
        except Exception:
            pass
    return "amethyst-frost"


def set_default(theme_id):
    src = os.path.join(PROFILES_DIR, f"{theme_id}.json")
    dst = os.path.join(PROFILES_DIR, "city.json")
    if not os.path.exists(src):
        return False
    shutil.copy2(src, dst)
    try:
        with open(DEFAULT_THEME_FILE, "w") as f:
            f.write(theme_id)
    except Exception:
        pass
    get_client().apply_theme(theme_id)
    return True


def read_raw_key(fd):
    b = os.read(fd, 32)
    if not b:
        return None

    if b in (b'\x1b[A', b'\x1bOA'):
        return 'UP'
    elif b in (b'\x1b[B', b'\x1bOB'):
        return 'DOWN'
    elif b in (b'\x1b[5~', b'\x1b[[5~'):
        return 'PAGE_UP'
    elif b in (b'\x1b[6~', b'\x1b[[6~'):
        return 'PAGE_DOWN'
    elif b in (b'\x1b[H', b'\x1b[1~'):
        return 'HOME'
    elif b in (b'\x1b[F', b'\x1b[4~'):
        return 'END'
    elif b == b'\x1b':
        return 'ESC'
    elif b in (b'\r', b'\n'):
        return 'ENTER'
    elif b == b' ':
        return 'SPACE'

    try:
        return b.decode('utf-8', errors='ignore')
    except Exception:
        return None


# ==============================================================
# Neat, Minimalist, Simple Menu
# ==============================================================

def interactive_menu():
    catalog = load_catalog()
    if not catalog:
        print("Error: No themes found.")
        return

    client = get_client()
    default_theme = get_default_theme()
    current_theme = get_current_theme()

    selected_idx = 0
    for idx, t in enumerate(catalog):
        if t["id"] == current_theme:
            selected_idx = idx
            break

    client.apply_theme(catalog[selected_idx]["id"])

    fd = sys.stdin.fileno()
    old_settings = termios.tcgetattr(fd)
    tty.setraw(fd)

    # Alternate screen buffer, hide cursor
    sys.stdout.write("\033[?1049h\033[?25l")
    sys.stdout.flush()

    status_notice = ""
    status_time = 0

    try:
        while True:
            try:
                term_cols, term_lines = os.get_terminal_size()
            except Exception:
                term_cols, term_lines = 80, 24

            page_size = max(5, term_lines - 6)
            top_idx = max(0, min(selected_idx - page_size // 2, len(catalog) - page_size))

            default_theme = get_default_theme()
            b_val = get_brightness()

            # Clean redraw without screen flicker
            buf = ["\033[H\033[J\n"]
            buf.append(f"  {BOLD}RGB Themes{RESET}\n\n")

            for i in range(top_idx, min(top_idx + page_size, len(catalog))):
                item = catalog[i]
                is_sel = (i == selected_idx)
                is_def = (item["id"] == default_theme)

                p = hex_to_rgb_tuple(item["primary"])
                s = hex_to_rgb_tuple(item["secondary"])
                a = hex_to_rgb_tuple(item["accent"])

                # Clean color blocks
                p_blk = f"\033[90m■■{RESET}" if sum(p) < 15 else f"{fg_color(*p)}██{RESET}"
                s_blk = f"\033[90m■■{RESET}" if sum(s) < 15 else f"{fg_color(*s)}██{RESET}"
                a_blk = f"\033[90m■■{RESET}" if sum(a) < 15 else f"{fg_color(*a)}██{RESET}"
                swatch = f"{p_blk} {s_blk} {a_blk}"

                def_tag = f"  {DIM}(default){RESET}" if is_def else ""

                if is_sel:
                    buf.append(f"  {BOLD}> {item['name']:<24s}  {swatch}{def_tag}{RESET}\033[K\n")
                else:
                    buf.append(f"    {item['name']:<24s}  {swatch}{def_tag}\033[K\n")

            # Fill remaining rows
            displayed = min(top_idx + page_size, len(catalog)) - top_idx
            for _ in range(page_size - displayed):
                buf.append("\033[K\n")

            buf.append("\n")
            if status_notice and time.time() - status_time < 2.0:
                buf.append(f"  {BOLD}{status_notice}{RESET}\033[K\n")
            else:
                buf.append(f"  {DIM}j/k or ↑/↓: move   enter: select   d: set default   +/-: brightness ({b_val}%)   q: quit{RESET}\033[K\n")

            sys.stdout.write("".join(buf))
            sys.stdout.flush()

            key = read_raw_key(fd)
            if not key:
                continue

            if key in ('UP', 'k', 'K'):
                selected_idx = (selected_idx - 1) % len(catalog)
                client.apply_theme(catalog[selected_idx]["id"])
            elif key in ('DOWN', 'j', 'J'):
                selected_idx = (selected_idx + 1) % len(catalog)
                client.apply_theme(catalog[selected_idx]["id"])
            elif key == 'PAGE_UP':
                selected_idx = max(0, selected_idx - page_size)
                client.apply_theme(catalog[selected_idx]["id"])
            elif key == 'PAGE_DOWN':
                selected_idx = min(len(catalog) - 1, selected_idx + page_size)
                client.apply_theme(catalog[selected_idx]["id"])
            elif key in ('-', '_', '[', '<'):
                new_b = max(5, get_brightness() - 10)
                set_brightness(new_b)
                status_notice = f"Brightness: {new_b}%"
                status_time = time.time()
            elif key in ('+', '=', ']', '>'):
                new_b = min(100, get_brightness() + 10)
                set_brightness(new_b)
                status_notice = f"Brightness: {new_b}%"
                status_time = time.time()
            elif key in ('d', 'D'):
                set_default(catalog[selected_idx]["id"])
                status_notice = f"Default set to {catalog[selected_idx]['name']}"
                status_time = time.time()
            elif key in ('ENTER', 'SPACE'):
                set_default(catalog[selected_idx]["id"])
                break
            elif key in ('q', 'Q', 'ESC'):
                break

    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
        sys.stdout.write("\033[?1049l\033[?25h")
        sys.stdout.flush()
        client.close()

    curr = catalog[selected_idx]
    is_def = (curr["id"] == get_default_theme())
    print(f"\nApplied: {BOLD}{curr['name']}{RESET} ({get_brightness()}%)" + (" [default]" if is_def else ""))


# ==============================================================
# Simple CLI Commands
# ==============================================================

def print_simple_list():
    catalog = load_catalog()
    default_theme = get_default_theme()
    current_theme = get_current_theme()

    print(f"\n{BOLD}RGB Themes ({len(catalog)} total):{RESET}\n")
    for t in catalog:
        p = hex_to_rgb_tuple(t["primary"])
        s = hex_to_rgb_tuple(t["secondary"])
        a = hex_to_rgb_tuple(t["accent"])
        p_blk = f"\033[90m■■{RESET}" if sum(p) < 15 else f"{fg_color(*p)}██{RESET}"
        s_blk = f"\033[90m■■{RESET}" if sum(s) < 15 else f"{fg_color(*s)}██{RESET}"
        a_blk = f"\033[90m■■{RESET}" if sum(a) < 15 else f"{fg_color(*a)}██{RESET}"
        swatch = f"{p_blk} {s_blk} {a_blk}"

        tags = []
        if t["id"] == current_theme:
            tags.append("[active]")
        if t["id"] == default_theme:
            tags.append("[default]")
        tag_str = " ".join(tags)

        print(f"  {t['name']:<24s}  {swatch}  {t['id']:<22s}  {DIM}{tag_str}{RESET}")
    print()


def main():
    if len(sys.argv) < 2:
        if sys.stdin.isatty():
            interactive_menu()
        else:
            print_simple_list()
        return

    cmd = sys.argv[1].lower()

    if cmd in ("-h", "--help", "help"):
        print("Usage:")
        print("  rgb-theme                       Interactive theme menu")
        print("  rgb-theme list                  List themes")
        print("  rgb-theme apply <name>          Apply a theme")
        print("  rgb-theme dim [percent]         Set brightness (e.g. 30)")
        print("  rgb-theme set-default <name>    Set permanent default")
        print("  rgb-theme current               Show active theme & brightness")
        return
    elif cmd in ("list", "ls"):
        print_simple_list()
    elif cmd in ("gui", "tui", "menu", "picker"):
        interactive_menu()
    elif cmd in ("dim", "brightness"):
        val = 30
        if len(sys.argv) >= 3:
            try:
                val = int(sys.argv[2])
            except ValueError:
                pass
        b = set_brightness(val)
        print(f"Brightness set to {b}%.")
    elif cmd == "current":
        curr = get_current_theme()
        deflt = get_default_theme()
        print(f"Active Theme : {curr}")
        print(f"Brightness   : {get_brightness()}%")
        print(f"Boot Default : {deflt}")
    elif cmd in ("set-default", "default"):
        if len(sys.argv) < 3:
            print("Usage: rgb-theme set-default <theme-name>")
            sys.exit(1)
        target = sys.argv[2].lower()
        if set_default(target):
            print(f"Default set to {target}.")
        else:
            print(f"Unknown theme: {target}")
            sys.exit(1)
    elif cmd in ("apply", "set"):
        if len(sys.argv) < 3:
            print("Usage: rgb-theme apply <theme-name>")
            sys.exit(1)
        target = sys.argv[2].lower()
        if get_client().apply_theme(target):
            print(f"Applied {target}.")
        else:
            print(f"Unknown theme: {target}")
            sys.exit(1)
    else:
        catalog = load_catalog()
        valid = [t["id"] for t in catalog]
        if cmd in valid or os.path.exists(os.path.join(PROFILES_DIR, f"{cmd}.json")):
            if get_client().apply_theme(cmd):
                print(f"Applied {cmd}.")
            else:
                print(f"Could not apply {cmd}.")
                sys.exit(1)
        else:
            print(f"Unknown theme: {cmd}. Run 'rgb-theme list' for options.")
            sys.exit(1)


if __name__ == "__main__":
    main()
