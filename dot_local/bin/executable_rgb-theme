#!/usr/bin/env python3
"""
rgb-theme: Fast, minimalist PC RGB theme manager and live previewer.
"""

import sys
import os
import json
import socket
import struct
import shutil
import termios
import tty
import time
import datetime

OPENRGB_HOST = "127.0.0.1"
OPENRGB_PORT = 6742
CONFIG_DIR = os.path.expanduser("~/.config/OpenRGB")
PROFILES_DIR = os.path.join(CONFIG_DIR, "profiles")
CATALOG_FILE = os.path.join(CONFIG_DIR, "themes.json")
STATE_DIR = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
CURRENT_THEME_FILE = os.path.join(STATE_DIR, "rgb-current-theme")
DEFAULT_THEME_FILE = os.path.join(CONFIG_DIR, "default-theme-id")
INHIBIT_FILE = os.path.join(STATE_DIR, "rgb-inhibit-until")

OPENRGB_BIN = shutil.which("openrgb") or os.path.expanduser("~/.local/bin/openrgb")


# ==============================================================
# Fast OpenRGB SDK Socket Client (Sub-millisecond hardware update)
# ==============================================================

class FastRGBClient:
    def __init__(self, host=OPENRGB_HOST, port=OPENRGB_PORT):
        self.host = host
        self.port = port
        self.sock = None
        self.profile_cache = {}
        self.connect()

    def connect(self):
        try:
            self.sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            self.sock.settimeout(0.5)
            self.sock.connect((self.host, self.port))
            # Handshake
            self.sock.sendall(struct.pack('<4sIII', b'ORGB', 0, 40, 4) + struct.pack('<I', 4))
            self.sock.recv(20)
            # Set client name
            name = b'RGBThemeFast\x00'
            self.sock.sendall(struct.pack('<4sIII', b'ORGB', 0, 50, len(name)) + name)
            return True
        except Exception:
            self.sock = None
            return False

    def load_profile_colors(self, theme_id):
        if theme_id in self.profile_cache:
            return self.profile_cache[theme_id]
        p_path = os.path.join(PROFILES_DIR, f"{theme_id}.json")
        if not os.path.exists(p_path):
            return None
        try:
            with open(p_path, 'r') as f:
                data = json.load(f)
            def int_to_rgb(val):
                return (val & 0xFF, (val >> 8) & 0xFF, (val >> 16) & 0xFF)
            ram = [int_to_rgb(c) for c in data['controllers'][0]['colors']]
            mobo = [int_to_rgb(c) for c in data['controllers'][2]['colors']]
            self.profile_cache[theme_id] = (ram, mobo)
            return ram, mobo
        except Exception:
            return None

    def send_update_leds(self, dev_id, colors_rgb):
        color_bytes = b''.join(struct.pack('BBBx', r, g, b) for r, g, b in colors_rgb)
        inner = struct.pack('<H', len(colors_rgb)) + color_bytes
        buff = struct.pack('<I', len(inner) + 4) + inner
        hdr = struct.pack('<4sIII', b'ORGB', dev_id, 1050, len(buff))
        self.sock.sendall(hdr + buff)

    def apply_theme(self, theme_id):
        colors = self.load_profile_colors(theme_id)
        if not colors:
            return False
        ram, mobo = colors
        if not self.sock:
            if not self.connect():
                return False
        try:
            self.send_update_leds(0, ram)
            self.send_update_leds(1, ram)
            self.send_update_leds(2, mobo)
            try:
                with open(CURRENT_THEME_FILE, "w") as f:
                    f.write(theme_id)
            except Exception:
                pass
            return True
        except Exception:
            if self.connect():
                try:
                    self.send_update_leds(0, ram)
                    self.send_update_leds(1, ram)
                    self.send_update_leds(2, mobo)
                    try:
                        with open(CURRENT_THEME_FILE, "w") as f:
                            f.write(theme_id)
                    except Exception:
                        pass
                    return True
                except Exception:
                    pass
        return False

    def close(self):
        if self.sock:
            try:
                self.sock.close()
            except Exception:
                pass
            self.sock = None


# Global fast client
_client = None

def get_client():
    global _client
    if _client is None:
        _client = FastRGBClient()
    return _client


def load_catalog():
    if os.path.exists(CATALOG_FILE):
        try:
            with open(CATALOG_FILE, "r") as f:
                return json.load(f)
        except Exception:
            pass
    return []


def hex_to_rgb_tuple(h):
    h = h.lstrip('#')
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)


def fg_color(r, g, b):
    return f"\033[38;2;{r};{g};{b}m"


def bg_color(r, g, b):
    return f"\033[48;2;{r};{g};{b}m"


RESET = "\033[0m"
BOLD = "\033[1m"
DIM = "\033[2m"
INVERT = "\033[7m"


def get_current_theme():
    if os.path.exists(CURRENT_THEME_FILE):
        try:
            with open(CURRENT_THEME_FILE, "r") as f:
                return f.read().strip()
        except Exception:
            pass
    return "amethyst-frost"


def get_default_theme():
    if os.path.exists(DEFAULT_THEME_FILE):
        try:
            with open(DEFAULT_THEME_FILE, "r") as f:
                return f.read().strip()
        except Exception:
            pass
    return "amethyst-frost"


def set_default(theme_id):
    src = os.path.join(PROFILES_DIR, f"{theme_id}.json")
    dst = os.path.join(PROFILES_DIR, "city.json")
    if not os.path.exists(src):
        return False
    shutil.copy2(src, dst)
    try:
        with open(DEFAULT_THEME_FILE, "w") as f:
            f.write(theme_id)
    except Exception:
        pass
    get_client().apply_theme(theme_id)
    return True


def hold_lighting(minutes=80):
    until = time.time() + (minutes * 60)
    target_dt = datetime.datetime.fromtimestamp(until)
    with open(INHIBIT_FILE, "w") as f:
        f.write(f"{until:.2f}\n")
    return target_dt


def is_hold_active():
    if os.path.exists(INHIBIT_FILE):
        try:
            with open(INHIBIT_FILE, "r") as f:
                until = float(f.read().strip())
            if time.time() < until:
                return True, datetime.datetime.fromtimestamp(until)
            else:
                os.remove(INHIBIT_FILE)
        except Exception:
            pass
    return False, None


def unhold_lighting():
    if os.path.exists(INHIBIT_FILE):
        try:
            os.remove(INHIBIT_FILE)
            return True
        except Exception:
            pass
    return False


# ==============================================================
# Robust Raw Key Reader (Supports j/k, arrows, PgUp/Dn, Esc)
# ==============================================================

def read_raw_key(fd):
    """
    Read raw bytes from stdin fd without Python buffer desync.
    Accurately maps arrow keys (\x1b[A, \x1bOA, etc.) and vim keys.
    """
    b = os.read(fd, 32)
    if not b:
        return None

    # Arrow keys (standard and application mode)
    if b in (b'\x1b[A', b'\x1bOA'):
        return 'UP'
    elif b in (b'\x1b[B', b'\x1bOB'):
        return 'DOWN'
    elif b in (b'\x1b[C', b'\x1bOC'):
        return 'RIGHT'
    elif b in (b'\x1b[D', b'\x1bOD'):
        return 'LEFT'
    elif b in (b'\x1b[5~', b'\x1b[[5~'):
        return 'PAGE_UP'
    elif b in (b'\x1b[6~', b'\x1b[[6~'):
        return 'PAGE_DOWN'
    elif b in (b'\x1b[H', b'\x1b[1~'):
        return 'HOME'
    elif b in (b'\x1b[F', b'\x1b[4~'):
        return 'END'
    elif b == b'\x1b':
        return 'ESC'
    elif b in (b'\r', b'\n'):
        return 'ENTER'
    elif b == b' ':
        return 'SPACE'
    
    # Text characters
    try:
        ch = b.decode('utf-8', errors='ignore')
        return ch
    except Exception:
        return None


# ==============================================================
# Clean, Simple Minimalist TUI
# ==============================================================

def interactive_menu():
    catalog = load_catalog()
    if not catalog:
        print("Error: No themes found in catalog.")
        return

    client = get_client()
    default_theme = get_default_theme()
    current_theme = get_current_theme()

    selected_idx = 0
    for idx, t in enumerate(catalog):
        if t["id"] == current_theme:
            selected_idx = idx
            break

    # Immediately activate on start
    client.apply_theme(catalog[selected_idx]["id"])

    # Prepare raw terminal mode
    fd = sys.stdin.fileno()
    old_settings = termios.tcgetattr(fd)
    tty.setraw(fd)

    # Alternate screen buffer, hide cursor
    sys.stdout.write("\033[?1049h\033[?25l")
    sys.stdout.flush()

    status_msg = ""
    status_time = 0

    try:
        while True:
            try:
                term_cols, term_lines = os.get_terminal_size()
            except Exception:
                term_cols, term_lines = 80, 24

            page_size = max(5, term_lines - 7)
            top_idx = max(0, min(selected_idx - page_size // 2, len(catalog) - page_size))

            default_theme = get_default_theme()
            curr = catalog[selected_idx]
            p_rgb = hex_to_rgb_tuple(curr["primary"])
            s_rgb = hex_to_rgb_tuple(curr["secondary"])
            a_rgb = hex_to_rgb_tuple(curr["accent"])

            # Left column width
            left_w = min(46, term_cols // 2)

            buf = ["\033[H\033[2J"]
            
            # Simple Header
            buf.append(f"{BOLD}RGB Theme Picker{RESET}  {DIM}({len(catalog)} themes){RESET}\n")
            buf.append("─" * min(term_cols - 1, 80) + "\n")

            # Prepare list items
            list_lines = []
            for i in range(top_idx, min(top_idx + page_size, len(catalog))):
                item = catalog[i]
                is_sel = (i == selected_idx)
                is_def = (item["id"] == default_theme)

                ip_rgb = hex_to_rgb_tuple(item["primary"])
                is_rgb = hex_to_rgb_tuple(item["secondary"])
                ia_rgb = hex_to_rgb_tuple(item["accent"])

                swatch = f"{bg_color(*ip_rgb)}  {bg_color(*is_rgb)}  {bg_color(*ia_rgb)}  {RESET}"
                def_mark = f" {DIM}[default]{RESET}" if is_def else ""

                if is_sel:
                    list_lines.append(f"{BOLD}> {item['id']:<20s} {swatch}{RESET}{def_mark}")
                else:
                    list_lines.append(f"  {item['id']:<20s} {swatch}{def_mark}")

            while len(list_lines) < page_size:
                list_lines.append("")

            # Prepare detail panel
            p_sw = f"{bg_color(*p_rgb)}    {RESET}"
            s_sw = f"{bg_color(*s_rgb)}    {RESET}"
            a_sw = f"{bg_color(*a_rgb)}    {RESET}"

            def_badge = "Yes" if curr["id"] == default_theme else "No"
            hold_act, hold_dt = is_hold_active()
            hold_str = f"Active until {hold_dt.strftime('%H:%M')}" if hold_act else "Off"

            detail_lines = [
                f"{BOLD}Theme:{RESET}       {curr['name']}",
                f"{BOLD}Category:{RESET}    {curr['category']}",
                f"{BOLD}Default:{RESET}     {def_badge}",
                f"{BOLD}Hold:{RESET}        {hold_str}",
                "",
                f"{BOLD}Colors:{RESET}",
                f"  Primary:   {curr['primary']}  {p_sw}",
                f"  Secondary: {curr['secondary']}  {s_sw}",
                f"  Accent:    {curr['accent']}  {a_sw}",
                "",
                f"{BOLD}Description:{RESET}",
                f"  {curr['desc'][:36]}",
            ]

            # Render rows side by side
            for row in range(page_size):
                l_str = list_lines[row] if row < len(list_lines) else ""
                r_str = detail_lines[row] if row < len(detail_lines) else ""
                buf.append(f"{l_str:<48s}  │  {r_str}\n")

            # Footer
            buf.append("─" * min(term_cols - 1, 80) + "\n")
            if status_msg and time.time() - status_time < 2.5:
                buf.append(f"{BOLD}{status_msg}{RESET}\n")
            else:
                buf.append(f"{DIM}j/k or ↑/↓: move  •  d: make default  •  enter: select & exit  •  q: exit{RESET}\n")

            sys.stdout.write("".join(buf))
            sys.stdout.flush()

            key = read_raw_key(fd)
            if not key:
                continue

            if key in ('UP', 'k', 'K'):
                selected_idx = (selected_idx - 1) % len(catalog)
                client.apply_theme(catalog[selected_idx]["id"])
            elif key in ('DOWN', 'j', 'J'):
                selected_idx = (selected_idx + 1) % len(catalog)
                client.apply_theme(catalog[selected_idx]["id"])
            elif key == 'PAGE_UP':
                selected_idx = max(0, selected_idx - 5)
                client.apply_theme(catalog[selected_idx]["id"])
            elif key == 'PAGE_DOWN':
                selected_idx = min(len(catalog) - 1, selected_idx + 5)
                client.apply_theme(catalog[selected_idx]["id"])
            elif key in ('HOME', 'g'):
                selected_idx = 0
                client.apply_theme(catalog[selected_idx]["id"])
            elif key in ('END', 'G'):
                selected_idx = len(catalog) - 1
                client.apply_theme(catalog[selected_idx]["id"])
            elif key in ('d', 'D'):
                set_default(catalog[selected_idx]["id"])
                status_msg = f"✓ Saved '{catalog[selected_idx]['id']}' as boot default"
                status_time = time.time()
            elif key in ('h', 'H'):
                if is_hold_active()[0]:
                    unhold_lighting()
                    status_msg = "✓ Lighting hold cleared"
                else:
                    hold_lighting(80)
                    status_msg = "✓ Lighting hold set for 80m"
                status_time = time.time()
            elif key in ('ENTER', 'SPACE'):
                set_default(catalog[selected_idx]["id"])
                break
            elif key in ('q', 'Q', 'ESC'):
                break

    finally:
        # Restore terminal settings
        termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
        sys.stdout.write("\033[?1049l\033[?25h")
        sys.stdout.flush()
        client.close()

    curr = catalog[selected_idx]
    is_def = (curr["id"] == get_default_theme())
    print(f"Active Theme: {BOLD}{curr['id']}{RESET} ({curr['name']})")
    if is_def:
        print(f"Boot Default: {BOLD}\033[32mSet as default in city.json{RESET}")


# ==============================================================
# CLI Commands
# ==============================================================

def print_clean_list():
    catalog = load_catalog()
    default_theme = get_default_theme()
    current_theme = get_current_theme()

    print(f"\n{BOLD}RGB Themes ({len(catalog)} total):{RESET}\n")
    current_cat = None
    for t in catalog:
        cat = t["category"]
        if cat != current_cat:
            print(f"\n{BOLD}# {cat}{RESET}")
            current_cat = cat

        p_tup = hex_to_rgb_tuple(t["primary"])
        s_tup = hex_to_rgb_tuple(t["secondary"])
        a_tup = hex_to_rgb_tuple(t["accent"])
        swatch = f"{bg_color(*p_tup)}  {bg_color(*s_tup)}  {bg_color(*a_tup)}  {RESET}"

        badges = []
        if t["id"] == current_theme:
            badges.append(f"{BOLD}[active]{RESET}")
        if t["id"] == default_theme:
            badges.append(f"{BOLD}\033[32m[default]{RESET}")
        b_str = " ".join(badges)

        print(f"  {t['id']:<22s} {swatch}  {t['desc']:<50s} {b_str}")
    print()


def main():
    if len(sys.argv) < 2:
        if sys.stdin.isatty():
            interactive_menu()
        else:
            print_clean_list()
        return

    cmd = sys.argv[1].lower()

    if cmd in ("-h", "--help", "help"):
        print(f"{BOLD}rgb-theme{RESET} - Minimalist PC RGB theme manager\n")
        print("Usage:")
        print("  rgb-theme                       Launch fast interactive theme picker")
        print("  rgb-theme list                  List all themes with color swatches")
        print("  rgb-theme apply <theme-id>      Instantly activate theme on hardware")
        print("  rgb-theme set-default <theme-id> Set theme as permanent boot & wake default")
        print("  rgb-theme current               Show active theme and hold status")
        print("  rgb-theme hold [mins]           Keep lighting on continuously (default 80)")
        print("  rgb-theme unhold                Clear lighting hold")
        return
    elif cmd in ("list", "ls"):
        print_clean_list()
    elif cmd in ("gui", "tui", "picker", "interactive"):
        interactive_menu()
    elif cmd == "current":
        curr = get_current_theme()
        deflt = get_default_theme()
        hold_act, hold_dt = is_hold_active()
        print(f"Active Theme : {curr}")
        print(f"Boot Default : {deflt}")
        print(f"Lighting Hold: {'Active until ' + hold_dt.strftime('%H:%M') if hold_act else 'Off'}")
    elif cmd in ("set-default", "default"):
        if len(sys.argv) < 3:
            print("Usage: rgb-theme set-default <theme-id>")
            sys.exit(1)
        target = sys.argv[2].lower()
        if set_default(target):
            print(f"Set '{target}' as permanent boot default.")
        else:
            print(f"Error: Unknown theme '{target}'. Run 'rgb-theme list' for available themes.")
            sys.exit(1)
    elif cmd in ("apply", "set"):
        if len(sys.argv) < 3:
            print("Usage: rgb-theme apply <theme-id>")
            sys.exit(1)
        target = sys.argv[2].lower()
        if get_client().apply_theme(target):
            print(f"Applied '{target}'.")
        else:
            print(f"Error: Could not apply '{target}'.")
            sys.exit(1)
    elif cmd == "hold":
        mins = 80
        if len(sys.argv) >= 3:
            try:
                mins = int(sys.argv[2])
            except ValueError:
                pass
        dt = hold_lighting(mins)
        print(f"Lighting hold active for {mins}m (until {dt.strftime('%H:%M')}).")
    elif cmd == "unhold":
        if unhold_lighting():
            print("Lighting hold removed.")
        else:
            print("Lighting hold was not active.")
    else:
        # Direct theme name passed e.g. `rgb-theme eva-01`
        catalog = load_catalog()
        valid = [t["id"] for t in catalog]
        if cmd in valid or os.path.exists(os.path.join(PROFILES_DIR, f"{cmd}.json")):
            if get_client().apply_theme(cmd):
                print(f"Applied '{cmd}'.")
            else:
                print(f"Could not apply '{cmd}'.")
                sys.exit(1)
        else:
            print(f"Unknown theme or command: '{cmd}'. Run 'rgb-theme list' for options.")
            sys.exit(1)


if __name__ == "__main__":
    main()
